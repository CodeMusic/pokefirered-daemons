@ T-218: THE READING ROOM. DRAFT WORDING, awaiting the user's approval.

ReadingRoom_Text_MayISee::
    .string "THE READING ROOM.\p"
    .string "May I see a DIPLOMA?$"

ReadingRoom_Text_NoDiploma::
    .string "...No?\p"
    .string "Graduates only, I'm afraid.\p"
    .string "CALLOW SCHOOL gives them out.\n"
    .string "It is not difficult. Just thorough.$"

ReadingRoom_Text_GoIn::
    .string "...CALLOW SCHOOL. That will do.\p"
    .string "Go in. Quietly, please.$"

ReadingRoom_Text_Faculty::
    .string "This whole building was a faculty,\n"
    .string "once. Now it is a room.\p"
    .string "People still come to read.\n"
    .string "Fewer every year.$"

ReadingRoom_Text_WhichDaemon::
    .string "Which of yours will sit in?$"

ReadingRoom_Text_LectureAnyTime::
    .string "The lecture runs whenever anyone\n"
    .string "wants it. Come back.$"

ReadingRoom_Text_LectureAttention::
    .string "My lecture is on ATTENTION.\p"
    .string "A daemon that has truly looked at\n"
    .string "something does not miss it next.\p"
    .string "Shall I teach one of yours?$"

ReadingRoom_Text_LectureAttentionDone::
    .string "It will not miss the next thing\n"
    .string "it looks at.$"

ReadingRoom_Text_LectureCategories::
    .string "My lecture is on CATEGORIES.\p"
    .string "Some daemons take on the kind of\n"
    .string "the ground they stand on.\p"
    .string "Shall I teach one of yours?$"

ReadingRoom_Text_LectureCategoriesDone::
    .string "It will take the kind of wherever\n"
    .string "it is standing.$"

ReadingRoom_Text_LectureError::
    .string "My lecture is on ERROR.\p"
    .string "Being hit first is information.\n"
    .string "Use it.\p"
    .string "Shall I teach one of yours?$"

ReadingRoom_Text_LectureErrorDone::
    .string "Twice as hard, when it was\n"
    .string "hit first.$"

ReadingRoom_Text_KeeperGive::
    .string "A graduate. Good.\p"
    .string "This is not a disc. It is not\n"
    .string "taught to anything.\p"
    .string "It goes into the TOOLKIT itself,\n"
    .string "and once it is in, it simply runs.$"

ReadingRoom_Text_RevealInstalled::
    .string "REVEAL was installed in\n"
    .string "the TOOLKIT.$"

ReadingRoom_Text_KeeperExplain::
    .string "Things that are there and not shown\n"
    .string "will show. Nothing more than that.$"

ReadingRoom_Text_KeeperAfter::
    .string "REVEAL is running. You will see it\n"
    .string "when there is something to see.$"

ReadingRoom_Text_ShelfFields::
    .string "A loose sheet, filed between two\n"
    .string "bound volumes as if to keep it.$"

ReadingRoom_Text_ShelfUnsent::
    .string "A letter, folded twice, used as a\n"
    .string "bookmark. It was never sent.$"

ReadingRoom_Text_ShelfObserver::
    .string "LAB NOTES, one volume of many:\n"
    .string "sessions with something called\l"
    .string "ARTSAI.$"

ReadingRoom_Text_ShelfBox::
    .string "LAB NOTES, the next volume.\n"
    .string "There is a diagram of a box.$"

ReadingRoom_Text_ShelfPosition::
    .string "A position paper, bound, signed at\n"
    .string "the bottom in a careful hand.$"

ReadingRoom_Text_ShelfDraft::
    .string "The same paper, a later draft.\n"
    .string "There is pencil in the margin.$"

ReadingRoom_Text_Catalogue::
    .string "A card catalogue. Most cards are\n"
    .string "for books nobody came back for.$"

