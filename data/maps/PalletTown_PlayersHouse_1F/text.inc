PalletTown_PlayersHouse_1F_Text_AllBoysLeaveOakLookingForYou::
    .string "MOM: You have that look.\p"
    .string "CRYSTAL CLEAR was here.\n"
    .string "She waited a while.$"

PalletTown_PlayersHouse_1F_Text_AllGirlsLeaveOakLookingForYou::
    .string "MOM: …You have that look.\p"
    .string "CRYSTAL CLEAR was here. She did\n"
    .string "not wait long.$"

PalletTown_PlayersHouse_1F_Text_YouShouldTakeQuickRest::
    .string "MOM: Sit down a moment.\p"
    .string "You are grey.$"

PalletTown_PlayersHouse_1F_Text_LookingGreatTakeCare::
    .string "MOM: You both look well.\p"
    .string "Go on, then.$"

PalletTown_PlayersHouse_1F_Text_MovieOnTVFourBoysOnRailroad::
    .string "Something is on.\p"
    .string "Four of them, following a line\n"
    .string "because it goes somewhere.\p"
    .string "…Right.$"

PalletTown_PlayersHouse_1F_Text_MovieOnTVGirlOnBrickRoad::
    .string "Something is on.\p"
    .string "One of them, following a road\n"
    .string "because it is the only road.\p"
    .string "…Right.$"

PalletTown_PlayersHouse_1F_Text_OopsWrongSide::
    .string "Wrong side.$"


PalletTown_PlayersHouse_1F_Text_MomTakeTheseShoes::
    .string "MOM: Wait. Take these.\p"
    .string "You never could stand still.$"

PalletTown_PlayersHouse_1F_Text_ReceivedRunningShoesFromMom::
    .string "{PLAYER} received the\n"
    .string "RUNNING SHOES from MOM.$"

PalletTown_PlayersHouse_1F_Text_ExplainRunningShoes::
    .string "MOM: Try them out. Hold B while\n"
    .string "you walk.\p"
    .string "You will need the room.$"

@  T-256, DRAFT: DAD.
PalletTown_PlayersHouse_1F_Text_DadTakeTheseShoes::
    .string "DAD: Here. Take these.\p"
    .string "They carried me further than\n"
    .string "I meant to go.$"

PalletTown_PlayersHouse_1F_Text_ReceivedRunningShoesFromDad::
    .string "{PLAYER} received the\n"
    .string "RUNNING SHOES from DAD.$"

PalletTown_PlayersHouse_1F_Text_DadExplainRunningShoes::
    .string "DAD: Hold B while you walk.\p"
    .string "Mind the stairs.$"

PalletTown_PlayersHouse_1F_Text_DadQuieter::
    .string "DAD: Your mother worries.\p"
    .string "So do I. Just quieter.$"

@  T-313, DRAFT.
PalletTown_PlayersHouse_1F_Text_MomTheShip::
    .string "MOM: You have a ticket for the\n"
    .string "S.S. ANNE.\p"
    .string "Find a chair by the pool on the top\n"
    .string "deck. Nobody hurries you there.\p"
    .string "And your brother has the ship now.\n"
    .string "Tell him to call his mother.$"

PalletTown_PlayersHouse_1F_Text_DadTheInitials::
    .string "DAD: The post still comes for\n"
    .string "DOCTOR.\p"
    .string "It is my initials. I stopped\n"
    .string "correcting them years ago.\p"
    .string "I sell diggers. Nobody has ever\n"
    .string "asked me to look at a rash.$"

PalletTown_PlayersHouse_1F_Text_DavidsNote::
    .string "A note on the wall, in your\n"
    .string "brother's hand.\p"
    .string "“Taking the ferries out to the\n"
    .string "islands this season. Back when\l"
    .string "the schedule says. -D.”$"
