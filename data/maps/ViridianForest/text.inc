ViridianForest_Text_FriendsItchingToBattle::
    .string "Four of us came out to bind SWARM.\p"
    .string "There is always more of it than\n"
    .string "there was last week.$"

ViridianForest_Text_RickIntro::
    .string "You have daemons running! Come on,\n"
    .string "engage!$"

ViridianForest_Text_RickDefeat::
    .string "No! CRAWLER could not keep up!$"

ViridianForest_Text_RickPostBattle::
    .string "Quiet. You will scatter them.\p"
    .string "They go where the noise is not.$"

ViridianForest_Text_DougIntro::
    .string "You are a USER. You do not get to\n"
    .string "walk past.$"

ViridianForest_Text_DougDefeat::
    .string "Huh? I have none left running.$"

ViridianForest_Text_DougPostBattle::
    .string "Right. I am going to bind better\n"
    .string "ones.$"

ViridianForest_Text_SammyIntro::
    .string "Hey, wait. Why is everyone always\n"
    .string "going somewhere?$"

ViridianForest_Text_SammyDefeat::
    .string "I give in. You are good at this.$"

ViridianForest_Text_SammyPostBattle::
    .string "Things end up on the ground here.\p"
    .string "I am looking for mine. If you find\n"
    .string "something, it was probably mine.$"

ViridianForest_Text_AnthonyIntro::
    .string "I am small. Do not adjust anything\n"
    .string "on my account.$"

ViridianForest_Text_AnthonyDefeat::
    .string "Oh. Nothing went the way I had it.$"

ViridianForest_Text_AnthonyPostBattle::
    .string "That was my allowance…$"

ViridianForest_Text_CharlieIntro::
    .string "Did you know they evolve? They do\n"
    .string "not ask first.$"

ViridianForest_Text_CharlieDefeat::
    .string "Oh. I lost.$"

ViridianForest_Text_CharliePostBattle::
    .string "SWARM evolves faster than anything\n"
    .string "else.\p"
    .string "You barely get to know one.$"

ViridianForest_Text_RanOutOfPokeBalls::
    .string "I have no USERBOXes left.\p"
    .string "Everything I meet now, I just\n"
    .string "meet.$"

ViridianForest_Text_AvoidGrassyAreasWhenWeak::
    .string "USER TIPS\p"
    .string "Nothing will announce itself if you\n"
    .string "stay off the grass.\p"
    .string "It is still there.$"

ViridianForest_Text_UseAntidoteForPoison::
    .string "USER TIPS\p"
    .string "For poison, use an ANTIDOTE. The\n"
    .string "MARTS carry them.$"

ViridianForest_Text_ContactOakViaPCToRatePokedex::
    .string "USER TIPS\p"
    .string "CRYSTAL will read your INDEX over\n"
    .string "the PC. She will tell you what is\l"
    .string "missing.$"

ViridianForest_Text_CantCatchOwnedMons::
    .string "Cut stone, half under the moss.\p"
    .string "A small figure carved above, hands\n"
    .string "folded.\p"
    .string "Symbols in rows, older than the\n"
    .string "path.\p"
    .string "Read across: each thing, and what\n"
    .string "it does to each other thing.\p"
    .string "Nobody signed it.$"

ViridianForest_Text_WeakenMonsBeforeCapture::
    .string "USER TIPS\p"
    .string "A daemon still at full strength will\n"
    .string "not stay in the box.\p"
    .string "Take it down first.$"

ViridianForest_Text_LeavingViridianForest::
    .string "LEAVING\n"
    .string "THE UNDERTONE\l"
    .string "SLATE CITY AHEAD$"

