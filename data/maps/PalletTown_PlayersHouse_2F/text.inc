PalletTown_PlayersHouse_2F_Text_PlayedWithNES::
    .string "The old machine still starts.\p"
    .string "Type a code?$"

PalletTown_PlayersHouse_2F_Text_CodeUnknown::
    .string "The cursor blinks.\p"
    .string "Nothing happens.$"

PalletTown_PlayersHouse_2F_Text_CodeTune::
    .string "The console plays a tune.$"

PalletTown_PlayersHouse_2F_Text_CodeTime::
    .string "PLAY TIME\n"
    .string "{STR_VAR_1} hours, {STR_VAR_2} minutes.$"

@ DRAFT (T-265, 2026-09-25): the TIME code when the cartridge has a clock. Awaiting the user's approval.
PalletTown_PlayersHouse_2F_Text_CodeTimeClock::
    .string "PLAY TIME\n"
    .string "{STR_VAR_1} hours, {STR_VAR_2} minutes.\p"
    .string "CLOCK\n"
    .string "{STR_VAR_3}$"

PalletTown_PlayersHouse_2F_Text_CodeMom::
    .string "A voice from downstairs.\p"
    .string "MOM: {PLAYER}? Are you still\n"
    .string "on that thing?$"

PalletTown_PlayersHouse_2F_Text_CodeStars::
    .string "The screen goes dark, then fills\n"
    .string "with small white points.\p"
    .string "They drift, very slowly, the\n"
    .string "way they do outside.$"

PalletTown_PlayersHouse_2F_Text_CodeLog::
    .string "BOOT OK.\n"
    .string "ONE USER.\p"
    .string "LAST ENTRY: {PLAYER}.\n"
    .string "NOTHING TO REPORT.$"

PalletTown_PlayersHouse_2F_Text_RiddleTune::
    .string "It has no voice, and still it\n"
    .string "sings.\p"
    .string "It goes round in your head for\n"
    .string "the rest of the day.\p"
    .string "Type what it is.$"

PalletTown_PlayersHouse_2F_Text_RiddleTime::
    .string "It runs without legs and it\n"
    .string "never stops.\p"
    .string "It has been counting since you\n"
    .string "first pressed START.\p"
    .string "Type what it is.$"

PalletTown_PlayersHouse_2F_Text_RiddleMom::
    .string "She calls up the stairs.\p"
    .string "Nobody ever answers the first\n"
    .string "time.\p"
    .string "Type what you call her.$"

PalletTown_PlayersHouse_2F_Text_RiddleStars::
    .string "They were there before the\n"
    .string "screen came on.\p"
    .string "They will be there when it goes\n"
    .string "off. Look up.\p"
    .string "Type what they are.$"

PalletTown_PlayersHouse_2F_Text_RiddleLog::
    .string "Every machine keeps one.\p"
    .string "Nobody reads it until\n"
    .string "something goes wrong.\p"
    .string "Type what it is.$"

PalletTown_PlayersHouse_2F_Text_PressLRForHelp::
    .string "Somebody pinned this up.\p"
    .string "L or R, if you get stuck.$"

