FourIsland_Text_IslandSign::
    .string "FOUR ISLAND\n"
    .string "Warm all the way round,\l"
    .string "and one cold room in it$"

FourIsland_Text_LoreleiHasReturned::
    .string "PHLEGMATIC has returned.\p"
    .string "Did she find the city life too\n"
    .string "stressful, I wonder?$"

FourIsland_Text_LoreleiMetLaprasAsChild::
	.string "PHLEGMATIC has gone back.\p"
	.string "She told the CORPUS people in\n"
	.string "STILLFALL CAVE to keep their hands\l"
	.string "off the DAEMON there.\p"
	.string "She didn't raise her voice. They\n"
	.string "left anyway.$"

FourIsland_Text_RivalAlreadyGotEggBeSmellingYa::
    .string "{RIVAL}: {PLAYER}.\p"
    .string "What are you doing in THE MARGINS?\p"
    .string "You keep turning up wherever I\n"
    .string "have just been.\p"
    .string "I have my EGG already. There is\n"
    .string "nothing else here for me.\p"
    .string "You do not know about EGGS. I can\n"
    .string "tell.\p"
    .string "That will cost you pages in the\n"
    .string "GLOBAL INDEX.\p"
    .string "Somebody we both know is on this\n"
    .string "island.\p"
    .string "Go and look, if you want to know.\p"
    .string "I do not have the time.$"

FourIsland_Text_LoreleiHasLotsOfStuffedDolls::
	.string "Oh, you found me!\p"
	.string "PHLEGMATIC sits by the water a\n"
	.string "whole day when she comes home.\p"
	.string "Grown-ups say she's wasting time.\n"
	.string "She says the water isn't.$"

FourIsland_Text_MadeSlushieUsingIcefallCaveIce::
    .string "Ooh, chilly!\p"
    .string "I made a slushie using ice I\n"
    .string "shaved inside STILLFALL CAVE.\p"
    .string "It's chilly and tasty!$"

FourIsland_Text_LoreleisHouse::
    .string "PHLEGMATIC'S HOUSE$"

