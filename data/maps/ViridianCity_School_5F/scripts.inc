@ CALLOW SCHOOL, 5F -- LEARNING (T-219, batch 5; docs/school.md 3-4).

ViridianCity_School_5F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, ViridianCity_School_5F_OnTransition
	.byte 0

ViridianCity_School_5F_OnTransition::
	setflag FLAG_SCHOOL_VISITED_5F
	end

ViridianCity_School_5F_EventScript_Teacher::
	msgbox ViridianCity_School_5F_Text_Teacher, MSGBOX_NPC
	end

ViridianCity_School_5F_EventScript_Everywhere::
	msgbox ViridianCity_School_5F_Text_Everywhere, MSGBOX_NPC
	end

ViridianCity_School_5F_EventScript_Sleep::
	msgbox ViridianCity_School_5F_Text_Sleep, MSGBOX_NPC
	end

ViridianCity_School_5F_EventScript_Lift::
	setvar VAR_0x8004, 5
	goto School_EventScript_Lift
	end

ViridianCity_School_5F_EventScript_Placard::
	msgbox ViridianCity_School_5F_Text_Placard, MSGBOX_SIGN
	end

ViridianCity_School_5F_EventScript_Syllabus::
	lockall
	msgbox ViridianCity_School_5F_Text_Syllabus
	goto_if_set FLAG_SCHOOL_SYLLABUS_LEARNING, ViridianCity_School_5F_EventScript_SyllabusHeld
	setflag FLAG_SCHOOL_SYLLABUS_LEARNING
	playse SE_SELECT
	msgbox ViridianCity_School_Text_TookSyllabus
	goto_if_unset FLAG_GOT_NOTEBOOK, ViridianCity_School_5F_EventScript_SyllabusHeld
	msgbox ViridianCity_School_Text_SyllabusIntoNotebook
ViridianCity_School_5F_EventScript_SyllabusHeld::
	releaseall
	end

ViridianCity_School_5F_EventScript_Board::
	lockall
	msgbox ViridianCity_School_2F_Text_BoardIntro
ViridianCity_School_5F_EventScript_ChooseTopic::
	message ViridianCity_School_Text_ReadWhichTopic
	waitmessage
	multichoice 19, 0, MULTICHOICE_SCHOOL_LEARNING, FALSE
	switch VAR_RESULT
	case 0, ViridianCity_School_5F_EventScript_ReadConnections
	case 1, ViridianCity_School_5F_EventScript_ReadPractice
	case 2, ViridianCity_School_5F_EventScript_ReadThreshold
	case 3, ViridianCity_School_5F_EventScript_ReadFeedback
	case 4, ViridianCity_School_5F_EventScript_ReadPruning
	case 5, ViridianCity_School_5F_EventScript_ExitBoard
	case 127, ViridianCity_School_5F_EventScript_ExitBoard
	end

ViridianCity_School_5F_EventScript_ReadConnections::
	msgbox ViridianCity_School_5F_Text_Connections
	goto ViridianCity_School_5F_EventScript_ChooseTopic
	end

ViridianCity_School_5F_EventScript_ReadPractice::
	msgbox ViridianCity_School_5F_Text_Practice
	goto ViridianCity_School_5F_EventScript_ChooseTopic
	end

ViridianCity_School_5F_EventScript_ReadThreshold::
	msgbox ViridianCity_School_5F_Text_Threshold
	goto ViridianCity_School_5F_EventScript_ChooseTopic
	end

ViridianCity_School_5F_EventScript_ReadFeedback::
	msgbox ViridianCity_School_5F_Text_Feedback
	goto ViridianCity_School_5F_EventScript_ChooseTopic
	end

ViridianCity_School_5F_EventScript_ReadPruning::
	msgbox ViridianCity_School_5F_Text_Pruning
	goto ViridianCity_School_5F_EventScript_ChooseTopic
	end

ViridianCity_School_5F_EventScript_ExitBoard::
	releaseall
	end
