ViridianCity_Mart_Text_YouCameFromPallet::
    .string "Hey. You came up from BLANCHE?$"

ViridianCity_Mart_Text_TakeThisToProfOak::
    .string "CRYSTAL CLEAR's order came in.\p"
    .string "A CC-7. Will you run it out to\n"
    .string "her?$"

ViridianCity_Mart_Text_ReceivedOaksParcelFromClerk::
    .string "{PLAYER} received the CC-7 from\n"
    .string "the REPO clerk.$"

ViridianCity_Mart_Text_SayHiToOakForMe::
    .string "Right. Tell CRYSTAL it came in.$"

ViridianCity_Mart_Text_ShopDoesGoodBusinessInAntidotes::
    .string "They shift a lot of PATCH here.\p"
    .string "Make of that what you like.$"

ViridianCity_Mart_Text_GotToBuySomePotions::
    .string "RESTORE. I always buy more than I\n"
    .string "think I need.\p"
    .string "You never find out you were wrong\n"
    .string "until it matters.$"


ViridianCity_Mart_Text_ShelfEnd::
    .string "There is a thing on the end of the\n"
    .string "shelf with no price on it.$"

ViridianCity_Mart_Text_TookOpus::
    .string "{PLAYER} took OPUS.$"

ViridianCity_Mart_Text_ShelfEndTaken::
    .string "The end of the shelf, where the\n"
    .string "prices start.$"

ViridianCity_Mart_Text_Shelf1::
    .string "Nothing on this shelf is the only one\n"
    .string "of itself.$"

ViridianCity_Mart_Text_Shelf2::
    .string "Everything here is a copy of\n"
    .string "something that worked once.$"

ViridianCity_Mart_Text_Shelf3::
    .string "The prices are on the shelf, not on\n"
    .string "the things.$"

ViridianCity_Mart_Text_ShelfWatcher::
    .string "That one on the end has no price\n"
    .string "on it. I asked.\p"
    .string "They said it is not theirs.$"

ViridianCity_Mart_Text_ShelfWatcherAfter::
    .string "It has gone. Nobody rang it up.$"
